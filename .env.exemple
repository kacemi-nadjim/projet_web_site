# Modèle du fichier .env de PRODUCTION — à copier en « .env » sur le serveur
# puis à compléter. Le fichier .env ne doit JAMAIS être versionné (Git).

DJANGO_DEBUG=False
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer-par-une-cle-aleatoire-de-50-caracteres
DJANGO_ALLOWED_HOSTS=nadjimkacemi.pythonanywhere.com
# Reçoit un e-mail à chaque erreur 500 (format Nom:adresse)
DJANGO_ADMINS=Nadjim:kasminadjim6@gmail.com
# Serveur d'envoi des alertes (ex. Gmail avec un « mot de passe d'application »)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=adresse.expediteur@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-d-application
SERVER_EMAIL=adresse.expediteur@gmail.com

# Base de données : absente = SQLite (fichier db.sqlite3 du projet).
# PostgreSQL : DATABASE_URL=postgres://pixbank_app:<mdp>@<hote>:5432/pixbank?sslmode=require
